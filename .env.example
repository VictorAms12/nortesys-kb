# Copie para .env.local. Use a conexao do banco Neon de desenvolvimento.
# A connection string deve incluir sslmode=require.
DATABASE_URL=

# Upload: store PRIVADO conectado ao projeto Vercel.
# O SDK pode usar BLOB_STORE_ID com a identidade OIDC fornecida pela Vercel.
# BLOB_STORE_ID=

# Alternativa para uma integracao que use token estatico:
# BLOB_READ_WRITE_TOKEN=

# Nunca prefixe essas variaveis com NEXT_PUBLIC_.
# Contas e sessoes ficam no PostgreSQL; KB_SESSION_SECRET nao e necessario.
# Detalhes e migracao inicial: docs/guias/configuracao.md

# Chat Realtime: chave PRIVADA do app Ably em Preview / Production.
# Nao usar prefixo NEXT_PUBLIC_.
# ABLY_API_KEY=

# Fase B: configurar no ambiente Vercel e no desenvolvimento conforme necessário.
# WEB_PUSH_SUBJECT=https://seu-dominio.example
# CRON_SECRET=gere-um-segredo-aleatorio-com-24-ou-mais-caracteres
# NOTIFICACOES_RETENCAO_DIAS=30
