    "testar:seguranca": "tsx scripts/testar-seguranca.ts",
    "verificar:fase5": "npm run verificar:fase55",
    "gerar:segredo": "node scripts/gerar-segredo.mjs",
    "usuario:adicionar": "node --env-file=.env.local scripts/db-usuarios.mjs adicionar",
    "usuario:listar": "node --env-file=.env.local scripts/db-usuarios.mjs listar",
    "usuario:remover": "node --env-file=.env.local scripts/db-usuarios.mjs remover",
    "usuario:senha": "node --env-file=.env.local scripts/db-usuarios.mjs senha",
    "testar:usuarios": "tsx scripts/testar-usuarios.ts",
