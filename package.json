{
  "name": "nortesys-kb",
  "version": "0.7.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run verificar && npm run validar:artigos && next build",
    "build:revisao": "node scripts/build-revisao.mjs",
    "testar:revisao": "tsx --test tests/testar-revisao.ts",
    "verificar:revisao": "node scripts/verificar-revisao.mjs",
    "start": "next start",
    "lint": "eslint .",
    "verificar:estrutura": "node scripts/verificar-estrutura.mjs",
    "verificar:documentacao": "node scripts/verificar-documentacao.mjs",
    "validar:artigos": "tsx scripts/validar-artigos.ts",
    "testar:validacao": "tsx tests/testar-validacao.ts",
    "testar:busca": "tsx tests/testar-busca.ts && tsx --test tests/testar-busca-ouro.ts",
    "testar:imagens": "tsx --test tests/testar-imagens.ts",
    "verificar": "node scripts/verificar-dados-sensiveis.mjs",
    "testar:seguranca": "tsx tests/testar-seguranca.ts",
    "usuario:adicionar": "node --env-file=.env.local scripts/db-usuarios.mjs adicionar",
    "usuario:listar": "node --env-file=.env.local scripts/db-usuarios.mjs listar",
    "usuario:remover": "node --env-file=.env.local scripts/db-usuarios.mjs remover",
    "usuario:senha": "node --env-file=.env.local scripts/db-usuarios.mjs senha",
    "testar:usuarios": "tsx tests/testar-usuarios.ts",
    "db:status": "node --env-file=.env.local scripts/db-usuarios.mjs status",
    "db:reconciliar": "node --env-file=.env.local scripts/db-usuarios.mjs reconciliar",
    "db:migrar": "node --env-file=.env.local scripts/db-usuarios.mjs migrar",
    "db:verificar": "node --env-file=.env.local scripts/db-usuarios.mjs verificar",
    "db:limpar": "node --env-file=.env.local scripts/db-usuarios.mjs limpar",
    "usuario:papel": "node --env-file=.env.local scripts/db-usuarios.mjs papel",
    "usuario:desativar": "node --env-file=.env.local scripts/db-usuarios.mjs desativar",
    "usuario:ativar": "node --env-file=.env.local scripts/db-usuarios.mjs ativar",
    "usuario:migrar": "node --env-file=.env.local scripts/db-usuarios.mjs importar",
    "testar:fase6": "tsx tests/testar-fase6.ts",
    "testar:anexos": "tsx --test tests/testar-anexos.ts",
    "testar:ferramentas": "tsx --test tests/testar-ferramentas.ts",
    "testar:chat": "tsx --test tests/testar-chat.ts",
    "testar:chat-acoes": "tsx --test tests/testar-chat-acoes.ts",
    "testar:chat-imagens": "tsx --test tests/testar-chat-imagens.ts",
    "testar:fases-7h-7j": "tsx --test tests/testar-fases-7h-7j.ts",
    "testar:chat-clipboard": "tsx --test tests/testar-chat-clipboard.ts",
    "testar:e2e": "playwright test -c playwright.config.mjs",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "format:check": "node scripts/verificar-formatacao.mjs",
    "format:prettier": "npx --yes prettier@3.6.2 --write src/lib/chat-sql.ts src/lib/chat-sql/*.ts scripts/verificar-formatacao.mjs .github/dependabot.yml .github/workflows/kb-verificacao.yml",
    "testar:e2e:listar": "playwright test --list -c playwright.config.mjs",
    "verificar:regras": "node scripts/verificar-revisao.mjs --regras"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "fuse.js": "^7.4.0",
    "gray-matter": "^4.0.3",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark": "^15.0.1",
    "remark-directive": "^3.0.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    }
  }
}
