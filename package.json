    "db:limpar": "node --env-file=.env.local scripts/db-usuarios.mjs limpar",
    "usuario:papel": "node --env-file=.env.local scripts/db-usuarios.mjs papel",
    "usuario:desativar": "node --env-file=.env.local scripts/db-usuarios.mjs desativar",
    "usuario:ativar": "node --env-file=.env.local scripts/db-usuarios.mjs ativar",
    "usuario:migrar": "node --env-file=.env.local scripts/db-usuarios.mjs importar",
    "testar:banco": "node scripts/testar-banco.mjs",
    "verificar:fase55": "npm run verificar:estrutura && npm run verificar && npm run validar:artigos && npm run testar:validacao && npm run testar:busca && npm run testar:seguranca && npm run testar:usuarios && npm run testar:banco && npm run lint && npm run build",
    "verificar:fase6": "npm run verificar:estrutura && npm run verificar && npm run validar:artigos && npm run testar:validacao && npm run testar:busca && npm run testar:seguranca && npm run testar:usuarios && npm run testar:fase6 && npm run testar:banco && npm run lint && npm run build",
